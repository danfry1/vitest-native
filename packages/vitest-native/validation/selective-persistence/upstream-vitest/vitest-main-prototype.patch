+describe('selective module reset', () => {
+  function evaluate(modules: EvaluatedModules, id: string, promise = Promise.resolve({ id })) {
+    const node = modules.ensureModule(id, id)
+    node.evaluated = true
+    node.exports = { id }
+    node.promise = promise
+    return node
+  }
+
+  test('preserves a coherent dependency closure and releases reset importers', async () => {
+    const modules = new EvaluatedModules()
+    const actual = evaluate(modules, '/resident-actual.ts')
+    const dependency = evaluate(modules, '/dependency.ts')
+    const consumer = evaluate(modules, '/consumer.ts')
+    actual.imports.add(dependency.id)
+    dependency.importers.add(actual.id)
+    dependency.imports.add(actual.id)
+    actual.importers.add(dependency.id)
+    actual.importers.add(consumer.id)
+    consumer.imports.add(actual.id)
+
+    const preserved = await getPreservedModules(modules, [/resident-actual\.ts$/])
+    resetModules(modules, true, preserved)
+
