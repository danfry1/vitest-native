+import { expect, test } from 'vitest'
+import { buildTestProjectTree, runInlineTests } from '#test-utils'
+
+function config(pool: 'threads' | 'forks' = 'threads') {
+  return `
+export default {
+  test: {
+    pool: '${pool}',
+    isolate: false,
+    fileParallelism: false,
+    maxWorkers: 1,
+    moduleIsolation: {
+      preserveActual: [/resident-actual\\.js$/],
+    },
+  },
+}
+`
+}
+
+const actual = /* js */ `
+import { dependencyIdentity, readCycleIdentity } from './dependency-a.js'
+globalThis.__actualEvaluations = (globalThis.__actualEvaluations ?? 0) + 1
+export const actualEvaluation = globalThis.__actualEvaluations
+export const identity = {}
+export const label = 'actual'
+export { dependencyIdentity }
+export const cycleIdentity = readCycleIdentity()
+globalThis.__actualIdentity = identity
+`
+
+const consumer = /* js */ `
+import * as actual from './resident-actual.js'
+globalThis.__consumerEvaluations = (globalThis.__consumerEvaluations ?? 0) + 1
+export const consumerEvaluation = globalThis.__consumerEvaluations
+export const readActual = () => actual
+`
+
+const dependencyA = /* js */ `
+import { readDependencyIdentity } from './dependency-b.js'
+export const dependencyIdentity = {}
+export const readCycleIdentity = () => readDependencyIdentity()
+`
+
+const dependencyB = /* js */ `
+import { dependencyIdentity } from './dependency-a.js'
+export const readDependencyIdentity = () => dependencyIdentity
+`
+
+const mockedTest = /* js */ `
+import { expect, test, vi } from 'vitest'
+vi.mock('./resident-actual.js', async (importOriginal) => ({
+  ...(await importOriginal()),
+  label: 'mocked',
+}))
+import { dependencyIdentity } from './dependency-a.js'
+import { consumerEvaluation, readActual } from './consumer.js'
+test('mocked overlay', async () => {
+  const value = readActual()
+  const original = await vi.importActual('./resident-actual.js')
+  globalThis.__filesExecuted = (globalThis.__filesExecuted ?? 0) + 1
+  expect(value.label).toBe('mocked')
+  expect(value.identity).toBe(original.identity)
+  expect(value.identity).toBe(globalThis.__actualIdentity)
+  expect(value.dependencyIdentity).toBe(dependencyIdentity)
+  expect(value.cycleIdentity).toBe(dependencyIdentity)
+  expect(value.actualEvaluation).toBe(1)
+  expect(consumerEvaluation).toBe(globalThis.__filesExecuted)
+})
+`
+
+const actualTest = /* js */ `
+import { expect, test } from 'vitest'
+import { dependencyIdentity } from './dependency-a.js'
+import { consumerEvaluation, readActual } from './consumer.js'
+test('unmocked actual', () => {
+  const value = readActual()
+  globalThis.__filesExecuted = (globalThis.__filesExecuted ?? 0) + 1
+  expect(value.label).toBe('actual')
+  expect(value.identity).toBe(globalThis.__actualIdentity)
+  expect(value.dependencyIdentity).toBe(dependencyIdentity)
+  expect(value.cycleIdentity).toBe(dependencyIdentity)
+  expect(value.actualEvaluation).toBe(1)
+  expect(consumerEvaluation).toBe(globalThis.__filesExecuted)
+})
+`
+
+test.each(['threads', 'forks'] as const)('preserves actual closure in the %s pool while resetting consumers and mock overlays', async (pool) => {
+  const { stderr, testTree } = await runInlineTests({
+    'vitest.config.js': config(pool),
+    'resident-actual.js': actual,
+    'consumer.js': consumer,
+    'dependency-a.js': dependencyA,
+    'dependency-b.js': dependencyB,
+    'a-mocked.test.js': mockedTest,
+    'b-actual.test.js': actualTest,
+    'c-mocked.test.js': mockedTest.replace('\'mocked overlay\'', '\'second mocked overlay\''),
+    'd-actual.test.js': actualTest.replace('\'unmocked actual\'', '\'second unmocked actual\''),
+  })
+
+  expect(stderr).toBe('')
+  expect(testTree()).toMatchInlineSnapshot(`
+    {
+      "a-mocked.test.js": {
+        "mocked overlay": "passed",
+      },
+      "b-actual.test.js": {
+        "unmocked actual": "passed",
+      },
+      "c-mocked.test.js": {
+        "second mocked overlay": "passed",
+      },
+      "d-actual.test.js": {
+        "second unmocked actual": "passed",
+      },
+    }
+  `)
+})
+
+test('retries a selected actual after a rejected evaluation', async () => {
+  const { stderr, testTree } = await runInlineTests({
+    'vitest.config.js': /* js */ `
+      class AlphabeticalSequencer {
+        sort(files) { return [...files].sort((a, b) => a.moduleId.localeCompare(b.moduleId)) }
+        shard(files) { return files }
+      }
+      export default {
+        test: {
+          isolate: false,
+          fileParallelism: false,
+          maxWorkers: 1,
+          sequence: { sequencer: AlphabeticalSequencer },
+          moduleIsolation: { preserveActual: [/resident-actual\\.js$/] },
+        },
+      }
+    `,
+    'resident-actual.js': /* js */ `
+      globalThis.__flakyEvaluations = (globalThis.__flakyEvaluations ?? 0) + 1
+      if (globalThis.__failActual) {
+        globalThis.__failActual = false
+        throw new Error('intentional failure')
+      }
+      export const evaluation = globalThis.__flakyEvaluations
+    `,
+    'a-failure.test.js': /* js */ `
+      import { expect, test } from 'vitest'
+      test('rejects once', async () => {
+        globalThis.__failActual = true
+        await expect(import('./resident-actual.js')).rejects.toThrow('intentional failure')
+      })
+    `,
+    'b-retry.test.js': /* js */ `
+      import { expect, test } from 'vitest'
+      test('retries', async () => {
+        const actual = await import('./resident-actual.js')
+        expect(actual.evaluation).toBe(2)
+      })
+    `,
+  })
+
+  expect(stderr).toBe('')
+  expect(testTree()).toMatchInlineSnapshot(`
+    {
+      "a-failure.test.js": {
+        "rejects once": "passed",
+      },
+      "b-retry.test.js": {
+        "retries": "passed",
+      },
+    }
+  `)
+})
+
+test('invalidates a preserved closure when a dependency changes', async () => {
+  const { fs, vitest } = await runInlineTests({
+    'vitest.config.js': config(),
+    'dependency.js': `export const value = 'value-one'`,
+    'resident-actual.js': /* js */ `
+      import { value } from './dependency.js'
+      export const read = () => value
+    `,
+    'basic.test.js': /* js */ `
+      import { expect, test } from 'vitest'
+      import { read } from './resident-actual.js'
+      test('reads dependency', () => {
+        console.log(read())
+        expect(read()).toMatch(/^value-/)
+      })
+    `,
+  }, { watch: true })
+
+  await vitest.waitForStdout('value-one')
+  await vitest.waitForStdout('Waiting for file changes')
+  vitest.resetOutput()
+  fs.editFile('dependency.js', source => source.replace('value-one', 'value-two'))
+  await vitest.waitForStdout('value-two')
+  await vitest.waitForStdout('1 passed')
+})
+
+test('keeps module isolation project-scoped', async () => {
+  const { results, stderr } = await runInlineTests({
+    'vitest.config.js': /* js */ `
+      const project = (name) => ({
+        test: {
+          name,
+          isolate: false,
+          fileParallelism: false,
+          maxWorkers: 1,
+          include: ['*.test.js'],
+          moduleIsolation: { preserveActual: [/resident-actual\\.js$/] },
+        },
+      })
+      export default { test: { projects: [project('selective-a'), project('selective-b')] } }
+    `,
+    'resident-actual.js': `export const identity = {}`,
+    'consumer.js': `import { identity } from './resident-actual.js'; export { identity }`,
+    'a.test.js': `import { expect, test } from 'vitest'; import { identity } from './consumer.js'; test('a', () => expect(identity).toBeTypeOf('object'))`,
+    'b.test.js': `import { expect, test } from 'vitest'; import { identity } from './consumer.js'; test('b', () => expect(identity).toBeTypeOf('object'))`,
+  })
+
+  expect(stderr).toBe('')
+  expect(buildTestProjectTree(results)).toMatchInlineSnapshot(`
+    {
+      "selective-a": {
+        "a.test.js": {
+          "a": "passed",
+        },
+        "b.test.js": {
+          "b": "passed",
+        },
+      },
+      "selective-b": {
+        "a.test.js": {
+          "a": "passed",
+        },
+        "b.test.js": {
+          "b": "passed",
+        },
+      },
+    }
+  `)
+})
