+import { expect, test } from 'vitest'
+import { buildTestProjectTree, runInlineTests } from '#test-utils'
+
+function config(pool: 'threads' | 'forks', setupFiles: string[] = []) {
+  return /* js */ `
+    class AlphabeticalSequencer {
+      sort(files) { return [...files].sort((a, b) => a.moduleId.localeCompare(b.moduleId)) }
+      shard(files) { return files }
+    }
+    export default {
+      test: {
+        isolate: 'modules',
+        pool: '${pool}',
+        fileParallelism: false,
+        maxWorkers: 1,
+        setupFiles: ${JSON.stringify(setupFiles)},
+        sequence: { sequencer: AlphabeticalSequencer },
+      },
+    }
+  `
+}
+
+const target = /* js */ `
+  globalThis.__targetEvaluations = (globalThis.__targetEvaluations ?? 0) + 1
+  export const evaluation = globalThis.__targetEvaluations
+  export const identity = {}
+  export const label = 'actual'
+`
+
+const consumer = /* js */ `
+  import * as target from './target.js'
+  globalThis.__consumerEvaluations = (globalThis.__consumerEvaluations ?? 0) + 1
+  export const evaluation = globalThis.__consumerEvaluations
+  export const readTarget = () => target
+`
+
+test.each(['threads', 'forks'] as const)('reuses the %s worker while resetting user modules and mocks', async (pool) => {
+  const { stderr, testTree } = await runInlineTests({
+    'vitest.config.js': config(pool),
+    'target.js': target,
+    'consumer.js': consumer,
+    'a-mocked.test.js': /* js */ `
+      import { expect, test, vi } from 'vitest'
+      vi.mock('./target.js', async importOriginal => ({
+        ...(await importOriginal()),
+        label: 'mocked',
+      }))
+      import { evaluation, readTarget } from './consumer.js'
+      test('mock overlay', async () => {
+        globalThis.__sharedRealmIdentity = {}
+        const value = readTarget()
+        const original = await vi.importActual('./target.js')
+        expect(value.label).toBe('mocked')
+        expect(value.identity).toBe(original.identity)
+        expect(value.evaluation).toBe(1)
+        expect(evaluation).toBe(1)
+      })
+    `,
+    'b-actual.test.js': /* js */ `
+      import { expect, test } from 'vitest'
+      import { evaluation, readTarget } from './consumer.js'
+      test('fresh actual', () => {
+        const value = readTarget()
+        expect(globalThis.__sharedRealmIdentity).toBeTypeOf('object')
+        expect(value.label).toBe('actual')
+        expect(value.evaluation).toBe(2)
+        expect(evaluation).toBe(2)
+      })
+    `,
+  })
+
+  expect(stderr).toBe('')
+  expect(testTree()).toMatchInlineSnapshot(`
+    {
+      "a-mocked.test.js": {
+        "mock overlay": "passed",
+      },
+      "b-actual.test.js": {
+        "fresh actual": "passed",
+      },
+    }
+  `)
+})
+
+test('keeps module and mock boundaries with two reused workers', async () => {
+  const structure: Record<string, string> = {
+    'vitest.config.js': /* js */ `
+      export default {
+        test: {
+          isolate: 'modules',
+          pool: 'threads',
+          fileParallelism: true,
+          maxWorkers: 2,
+          minWorkers: 2,
+        },
+      }
+    `,
+    'target.js': `export const label = 'actual'`,
+    'consumer.js': /* js */ `
+      import * as target from './target.js'
+      export const identity = {}
+      export const readTarget = () => target
+    `,
+  }
+  for (let index = 0; index < 8; index++) {
+    const mocked = index % 2 === 0
+    structure[`case-${index}.test.js`] = /* js */ `
+      import { expect, test, vi } from 'vitest'
+      ${mocked ? `vi.mock('./target.js', () => ({ label: 'mocked' }))` : ''}
+      import { identity, readTarget } from './consumer.js'
+      test('case ${index}', () => {
+        globalThis.__moduleModeConsumers ??= new Set()
+        expect(globalThis.__moduleModeConsumers.has(identity)).toBe(false)
+        globalThis.__moduleModeConsumers.add(identity)
+        expect(readTarget().label).toBe('${mocked ? 'mocked' : 'actual'}')
+      })
+    `
+  }
+
+  const { stderr, testTree } = await runInlineTests(structure)
+
+  expect(stderr).toBe('')
+  expect(testTree()).toMatchInlineSnapshot(`
+    {
+      "case-0.test.js": {
+        "case 0": "passed",
+      },
+      "case-1.test.js": {
