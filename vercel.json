{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "node website/scripts/fetch-fidelity-matrix.mjs && SITE_BASE=/ bun run build:website",
  "outputDirectory": "website/.vitepress/dist",
  "framework": null,
  "cleanUrls": true,
  "ignoreCommand": "bash website/scripts/skip-unless-site-changed.sh",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "docs/**": true
    }
  }
}
