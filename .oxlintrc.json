{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import"],
  "jsPlugins": ["./packages/vitest-native/lint/vitest-native-rules.mjs"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "nursery": "off"
  },
  "rules": {
    "no-unused-vars": "error",
    "no-console": "off",
    "no-underscore-dangle": "off",
    "typescript/no-explicit-any": "off",
    "unicorn/no-thenable": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    "import/no-unassigned-import": "off"
  },
  "overrides": [
    {
      "files": ["packages/vitest-native/src/**"],
      "rules": {
        "vitest-native/no-monkey-patching": "error",
        "vitest-native/no-doc-urls-in-src": "error",
        "vitest-native/root-containment": "error"
      }
    }
  ],
  "settings": {
    "react": {
      "formComponents": [],
      "linkComponents": [],
      "version": "19",
      "componentWrapperFunctions": []
    },
    "vitest": {
      "typecheck": false
    }
  },
  "env": {
    "builtin": true
  },
  "globals": {},
  "ignorePatterns": ["dist", "node_modules", "packages/vitest-native/tests-native/fixtures"]
}
